# Copia este archivo como server/.env y ajusta los valores. NUNCA subas .env a GitHub.
FERREMAX_PORT=8000
# Credenciales del administrador inicial (se crea solo si aun no existe ningun admin)
FERREMAX_ADMIN_EMAIL=admin@ferremax.local
# Descomenta y pon una clave larga y propia. Si la dejas comentada, el servidor genera una clave
# aleatoria y la muestra UNA vez en la consola al crear el administrador.
# FERREMAX_ADMIN_PASSWORD=
# Origenes del frontend autorizados por CORS (separados por coma)
FERREMAX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5500,http://127.0.0.1:5500
# Horas de vida de una sesion
FERREMAX_SESSION_HOURS=12
